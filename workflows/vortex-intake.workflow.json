      }
    },
    {
      "id": "b2f0c2d3-0002-4a02-9a02-vortexcfg01",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
