# Environment for the plane/ compose stack (n8n + vortex sidecars) behind
# Nginx Proxy Manager. Copy to .env next to compose.yml and fill in values.
# The host's live compose file has drifted from the repo (bridge env lines
# added directly on the host) — this file is the authoritative variable list.

# ─── n8n core ───
# Encryption key for n8n credentials. Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me

# Public host: the stack is reachable at https://${SUBDOMAIN}.${DOMAIN_NAME}/
SUBDOMAIN=nodemation
DOMAIN_NAME=nforensic.site

# IANA timezone for the n8n UI and Schedule Triggers.
GENERIC_TIMEZONE=Europe/Lisbon

# ─── GitLab ↔ Plane bridge (files/gitlab-plane-bridge/) ───
# Your Plane workspace slug (from Plane URL: plane.nforensic.site/<slug>/...)
WORKSPACE_SLUG=pdmfc

# Secret string — set the SAME value in every GitLab repo's webhook config
# (Settings → Webhooks → Secret Token field)
WEBHOOK_SECRET=change-me-to-a-random-string

# Plane API key — sent as X-Api-Key by every Plane HTTP node.
PLANE_API_KEY=plane_xxxxxxxx

# GitLab access token (api scope) — sent as PRIVATE-TOKEN by every GitLab node.
GITLAB_API_TOKEN=glpat-xxxxxxxxxxxx

# Plane DEV project UUID + state UUIDs as a JSON string.
# If Plane states change, update this — no workflow JSON edits needed.
PLANE_PROJECT_DEV={"uuid":"b5842796-7af7-474c-bf17-012977399c16","states":{"backlog":"e3bde020-6ce7-4b87-b994-2ebb28c14d84","todo":"6af7ed32-6610-44e3-be3f-f405b16d2d35","inProgress":"16099284-4b49-4ed3-af2a-d99e21d0e154","inReview":"a24250ec-212a-49ee-ad59-6d31e8b181ae","done":"56c26d40-418d-4d71-8f49-ecf0ba0837ad","cancelled":"c69e0a4f-6fa8-4aa6-85c8-26a8162db905"}}

# GitLab group ID — the backstop (WF2) auto-discovers all repos under this
# group (including subgroups). Find via GitLab → group Settings, or
# GET /api/v4/groups?search=novaforensic
GITLAB_GROUP_ID=3175

# ─── Plane DEV Daily Briefing (files/plane-daily-briefing/, optional) ───
# See files/plane-daily-briefing/README.md for setup.
OPENAI_API_KEY=sk-xxxxxxxx
PLANE_DAILY_BRIEFING_OPENAI_MODEL=gpt-5-mini
PLANE_DAILY_BRIEFING_TELEGRAM_CHAT_ID=-1001234567890
PLANE_DAILY_BRIEFING_RECIPIENTS=[{"planeUserId":"<plane-user-uuid>","displayName":"<Display Name>","telegramUsername":"<telegram-username>"}]

# ─── Vortex announcements (files/vortex-announcements/) ───
# Token Abilio presents to the n8n webhook (X-Vortex-Publish-Token header).
# Generate: openssl rand -hex 32
VORTEX_PUBLISH_TOKEN=change-me

# Token n8n presents to the vortex-publisher sidecar (X-Publisher-Token
# header). MUST differ from VORTEX_PUBLISH_TOKEN.
# Generate: openssl rand -hex 32
VORTEX_SIDECAR_TOKEN=change-me-too

# Feed reader credentials (HTTP Basic auth): whitespace-separated
# user:password pairs, one per Vortex NUC. Passwords must not contain
# whitespace. Empty = public feed (no auth required).
# Example: VORTEX_FEED_READERS=nuc1:s3cret nuc2:other
VORTEX_FEED_READERS=

# Realm string shown in the browser/HTTP-client auth prompt.
VORTEX_FEED_AUTH_REALM=Vortex announcements
